<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_fsm_timesheet_hours" model="ir.ui.view">
        <field name="name">project.task.form.fsm.timesheet.hours</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="priority" eval="9999" />
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/group/group/label[@for='date_deadline']" position="attributes">
                <attribute name="string">Fecha y hora asignadas</attribute>
            </xpath>
            <xpath
                expr="/form/sheet/group/group/div[@id='date_deadline_and_recurring_task']/field[@name='date_deadline']"
                position="attributes">
                <attribute name="options">
                    {"start_date_field":"planned_date_begin","always_range":"1","numeric":true}
                </attribute>
            </xpath>
            <xpath expr="/form//page[@name='sub_tasks_page']" position="replace" />
            <xpath expr="/form//page[@id='timesheets_tab']" position="replace" />
            <xpath expr="/form//page[@name='extra_info']" position="after">
                <page string="Parte de Horas" name="timesheets_page">
                    <field name="timesheet_ids">
                        <list editable="top" string="Timesheet Activities" sample="1"
                            decoration-muted="readonly_timesheet == True">
                            <field name="readonly_timesheet" column_invisible="True" />
                            <field name="date" readonly="readonly_timesheet or timer_start" />
                            <field optional="show" name="start_hour"
                                options="{&quot;numeric&quot;:true,&quot;rounding&quot;:15}" />
                            <field optional="show" name="final_hour"
                                options="{&quot;numeric&quot;:true,&quot;rounding&quot;:15}"
                                string="Hora Fin" />
                            <field name="employee_id" column_invisible="0"
                                readonly="readonly_timesheet" required="1"
                                widget="many2one_avatar_employee" context="{'active_test': True}" />
                            <field name="has_helpdesk_team" column_invisible="True" />
                            <field name="helpdesk_ticket_id"
                                invisible="not has_helpdesk_team or task_id"
                                readonly="readonly_timesheet" optional="hide"
                                groups="helpdesk_timesheet.group_use_helpdesk_timesheet"
                                context="{'default_project_id': project_id}" />
                            <field name="helpdesk_ticket_id" column_invisible="True" />
                            <field name="name" optional="show" required="0"
                                readonly="readonly_timesheet" />
                            <field name="is_so_line_edited" column_invisible="True" />
                            <field name="so_line" widget="so_line_field" optional="show"
                                options="{'no_create': True, 'no_open': True}"
                                context="{'create': False, 'edit': False, 'delete': False}"
                                readonly="readonly_timesheet"
                                column_invisible="context.get('hide_so_line')"
                                placeholder="Non-billable"
                                groups="sales_team.group_sale_salesman" />
                            <field name="unit_amount" string="Time Spent" optional="show"
                                widget="timesheet_uom"
                                sum="Total"
                                readonly="id and (readonly_timesheet or timer_start)"
                                decoration-danger="unit_amount &gt; 24 or unit_amount &lt; 0"
                                decoration-muted="unit_amount == 0" />
                            <field name="attachment_number" string="Nº Adjuntos" optional="show" />
                            <field name="attachment_ids" widget="many2many_binary"
                                string="Adjuntos" icon="fa-paperclip"
                            />
                            <!--  class="o_attachment_preview" style="max-height: 80px; overflow-y:
                            auto;"-->
                            <field name="company_id" column_invisible="True" />
                            <field name="user_id" column_invisible="True" />
                            <field name="is_timer_running" column_invisible="True" />
                            <field name="timer_start" column_invisible="True" />
                            <field name="display_timer" column_invisible="True" />
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="/form//field[@name='project_id']" position="after">
                <field name="service_for_or_the_third_parties" />
                <field name="original_ticket" />
                <field name="ticket_manager" />

            </xpath>

            <xpath expr="/form//field[@name='user_ids']" position="after">
                <field name="intervention_date" />
            </xpath>
        </field>
    </record>
</odoo>
