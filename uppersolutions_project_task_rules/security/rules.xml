<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Override the base rule for internal users -->
        <record model="ir.rule" id="project.task_visibility_rule">
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        </record>

        <!-- Override the base rule for project users -->
        <record model="ir.rule" id="project.task_visibility_rule_project_user">
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        </record>

        <!-- Override the base rule for private tasks -->
        <record id="project.ir_rule_private_task" model="ir.rule">
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
        </record>
    </data>
</odoo>
