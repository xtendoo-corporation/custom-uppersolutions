<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_category_form_view_inherit_uppersolutions_project_report" model="ir.ui.view">
        <field name="name">product.category.form.uppersolutions.project.report</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="inside">
                <field name="is_hour_category"/>
                <field name="is_travel_category"/>
            </xpath>
        </field>
    </record>
</odoo>

