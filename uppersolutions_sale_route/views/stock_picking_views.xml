<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_related_pickings" model="ir.ui.view">
        <field name="name">stock.picking.form.related.pickings</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object"
                    name="action_view_related_pickings"
                    class="oe_stat_button"
                    icon="fa-exchange"
                    invisible="related_picking_count == 0">
                    <field name="related_picking_count" widget="statinfo"
                        string="Traslados Relacionados" />
                </button>
            </div>
        </field>
    </record>
</odoo>